{
  "name": "hatoms-portfolio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "api:dev": "cd backend && uvicorn app.main:app --reload --host 0.0.0.0 --port 8000",
    "test:api": "cd backend && pytest -v",
    "deploy": "docker compose -f docker-compose.prod.yml up -d --build",
    "deploy:ps": "docker compose -f docker-compose.prod.yml ps",
    "deploy:logs": "docker compose -f docker-compose.prod.yml logs -f"
  },
  "dependencies": {
    "@radix-ui/react-slot": "latest",
    "@tailwindcss/vite": "latest",
    "class-variance-authority": "latest",
    "clsx": "latest",
    "framer-motion": "latest",
    "lenis": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-icons": "latest",
    "react-intersection-observer": "latest",
    "react-router-dom": "latest",
    "tailwind-merge": "latest",
    "tailwindcss": "latest"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "eslint": "latest",
    "eslint-plugin-react-hooks": "latest",
    "eslint-plugin-react-refresh": "latest",
    "globals": "latest",
    "typescript": "latest",
    "typescript-eslint": "latest",
    "vite": "latest"
  }
}
