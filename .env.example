# Корневой env для Docker Compose (локально и на сервере).
# Скопируйте: cp .env.example .env

# --- PostgreSQL ---
POSTGRES_DB=hatoms
POSTGRES_USER=hatoms
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_PORT=5432

# --- API / App ---
APP_NAME=HATOMS Applications API
ADMIN_TOKEN=change-me-admin-token
API_PORT=8000
WEB_PORT=80

# Origins фронтенда (через запятую). В проде укажите ваш домен:
# CORS_ORIGINS=https://example.com,https://www.example.com
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost

DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
