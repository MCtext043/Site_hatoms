# Корневой env для Docker Compose (локально и на сервере).
# Скопируйте: cp .env.example .env
# Затем: ./deploy/deploy.sh   или   .\deploy\deploy.ps1

# --- PostgreSQL ---
POSTGRES_DB=hatoms
POSTGRES_USER=hatoms
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_PORT=5432

# --- API / App ---
APP_NAME=HATOMS Applications API
ADMIN_TOKEN=change-me-admin-token
API_PORT=8000
WEB_PORT=8080

# Origins фронтенда (через запятую). В проде укажите ваш домен/IP:
# CORS_ORIGINS=http://example.com,http://www.example.com
CORS_ORIGINS=http://45.11.26.79:8080,http://45.11.26.79,http://127.0.0.1:8080,http://localhost:8080

DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
