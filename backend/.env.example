# Скопируйте в .env и при необходимости измените значения.
# cp .env.example .env

APP_NAME=HATOMS Applications API
APP_ENV=development

# Токен для /admin и защищённых GET-эндпоинтов
ADMIN_TOKEN=change-me-admin-token

# PostgreSQL (локально через docker compose — см. README)
DATABASE_URL=postgresql+psycopg://hatoms:hatoms@localhost:5432/hatoms

# Через запятую, без пробелов или с пробелами — оба варианта ок
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
